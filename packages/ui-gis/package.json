{
  "name": "@znlgis/dsh-ui-gis",
  "version": "0.1.0",
  "description": "GIS map rendering and browsing surfaces for the DSH Web client",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.*.js",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-client-chunks.mjs && tsc -b && tsdown && node ../../scripts/flatten-client-chunks.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.7-rc.2",
    "@types/node": "^24.0.0",
    "flatgeobuf": "^4.4.0",
    "geotiff": "^3.0.5",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.5.0",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@znlgis/dsh-gis-core": "workspace:^"
  }
}
