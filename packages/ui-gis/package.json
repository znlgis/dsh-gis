{
  "name": "@znlgis/dsh-ui-gis",
  "version": "0.1.0",
  "description": "GIS map rendering and browsing surfaces for the DSH Web client",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.*.js",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-alpha.2",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-alpha.2"
  }
}
