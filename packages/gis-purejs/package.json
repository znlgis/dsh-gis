{
  "name": "@znlgis/dsh-gis-purejs",
  "version": "0.1.0",
  "description": "Pure-JS GIS provider: reads GeoJSON, NDJSON, WKT and shapefile families without GDAL",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -b && tsdown"
  },
  "license": "MIT",
  "dependencies": {
    "@znlgis/dsh-gis-core": "workspace:^",
    "@znlgis/dsh-gis-formats": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@types/node": "^24.0.0"
  }
}
